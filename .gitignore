# Environment variables & secrets
.env
*.env.local

# Footage & Rendered Media (hindari upload file video besar ke git)
footage/*
!footage/.gitkeep
clips/*
!clips/.gitkeep
ready_to_upload/*
!ready_to_upload/.gitkeep

# Python cache & temp
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS specific
.DS_Store
Thumbs.db

# Logs
logs/*.json
logs/*.jsonl
!logs/.gitkeep

# Compiled binaries
scripts/generate_overlays
scripts/transcribe
scripts/generate_sample_ctd_overlay
scripts/generate_ctd_newsroom_overlays
scripts/generate_5_ctd_overlays
scripts/generate_5_distinct_overlays
*.o
